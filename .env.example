# サーバー用。ローカルはリポジトリ直下の .env に実キーを置く（.env は gitignore 済み）。
# デプロイ時はホスティングサービスの環境変数として設定する。
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# 本番デプロイでは production を設定する。
# production のときだけ client/dist の静的配信と SPA フォールバックが有効になり、
# CORS ヘッダを出さなくなる（同一オリジンのため不要）。
NODE_ENV=

# 待ち受けポート。多くのホスティングサービスが自動で渡すので、通常は設定不要（既定 3001）。
PORT=

# --- 公開ガード（スライスB）---
# 1日にAIを使えるゲーム数。既定 5。0 にすると常に簡易モード。
# ⚠️ カウンタはメモリ上にしか無いので、再デプロイ・再起動で枠は戻る。
#    本当の最後の砦は Anthropic / Groq コンソール側の支払上限。
DAILY_GAME_LIMIT=

# false で枠に関係なく全ゲームを簡易モード（手書き台本＋スタブ採点）にする。
AI_ENABLED=

# false で新規ルーム作成を拒否する。進行中のゲームは継続する。
PUBLIC_ENABLED=

# 重要: 部屋の状態はプロセスのメモリ上にしか無い。
# 複数インスタンス（オートスケール・レプリカ数>1）で動かすと「部屋が見つからない」
# 「一部のプレイヤーにしかイベントが届かない」等が無言で発生する。
# 必ず単一インスタンス（replicas=1・オートスケール無効）で運用すること。
# また再起動すると進行中のゲームはすべて失われる。
